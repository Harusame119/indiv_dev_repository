<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- namespaceはMapperインターフェースの完全修飾名 -->
<mapper namespace="com.expenses.springboot.repository.TblCategoryMapper">

  <!-- ユーザー名で検索するSQL -->
  <select id="findByUserId" parameterType="java.lang.String" resultType="com.expenses.springboot.entity.TblCategoryEntity">
    SELECT CATEGORY_ID, CATEGORY_NAME, USER_ID, SORT_ORDER
    FROM TBL_CATEGORY
      <where>
        USER_ID = #{userId}
      </where>
    ORDER BY SORT_ORDER
  </select>

  <!-- 登録 -->
  <insert id="insert" parameterType="com.expenses.springboot.entity.TblCategoryEntity" useGeneratedKeys="true" keyProperty="categoryId">
    INSERT INTO TBL_CATEGORY (CATEGORY_NAME, USER_ID, SORT_ORDER)
    VALUES (#{categoryName}, #{userId}, #{sortOrder})
  </insert>

  <!-- 主キー削除 -->
  <delete id="deleteById" parameterType="java.lang.Integer">
    DELETE FROM TBL_CATEGORY
      <where>
        CATEGORY_ID = #{categoryId}
      </where>
  </delete>

  <!-- 表示順更新 -->
  <update id="updateSortOrderById" parameterType="com.expenses.springboot.entity.TblCategoryEntity">
    UPDATE TBL_CATEGORY
    SET
    SORT_ORDER = #{sortOrder}
      <where>
        CATEGORY_ID = #{categoryId}
      </where>
  </update>

</mapper>
